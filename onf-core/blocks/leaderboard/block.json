{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "onf/leaderboard",
	"title": "Leaderboard",
	"icon": "awards",
	"description": "Top fundraisers in an event, or the whole roster with what each player raised.",
	"category": "onf",
	"keywords": [
		"top",
		"fundraisers",
		"roster",
		"players"
	],
	"textdomain": "onf-core",
	"attributes": {
		"event": {
			"type": "integer",
			"default": 0
		},
		"limit": {
			"type": "integer",
			"default": 10
		},
		"layout": {
			"type": "string",
			"default": "list",
			"enum": [
				"list",
				"grid"
			]
		},
		"heading": {
			"type": "string",
			"default": "Top fundraisers"
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "onf-blocks-editor",
	"style": "onf-blocks"
}
