{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "onf/player-profile",
	"title": "Player profile",
	"icon": "id-alt",
	"description": "One part of the player's profile: photo, number and position, facts, events with totals, or EliteProspects stats.",
	"category": "onf",
	"textdomain": "onf-core",
	"attributes": {
		"part": {
			"type": "string",
			"default": "facts",
			"enum": [
				"photo",
				"eyebrow",
				"facts",
				"events",
				"stats",
				"alltime"
			]
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "onf-blocks-editor",
	"style": "onf-blocks"
}
