{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "onf/series-totals",
	"title": "Series totals",
	"icon": "editor-table",
	"description": "A series by year: each fund, player pages and general, with the campaign total per year.",
	"category": "onf",
	"textdomain": "onf-core",
	"attributes": {
		"series": {
			"type": "integer",
			"default": 0
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "onf-blocks-editor",
	"style": "onf-blocks"
}
