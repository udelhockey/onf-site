{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Card",
	"slug": "card",
	"blockTypes": [
		"core/group",
		"core/column"
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"border": {
			"color": "var(--wp--preset--color--line)",
			"width": "1px",
			"style": "solid",
			"radius": "var(--wp--custom--radius--card)"
		},
		"spacing": {
			"padding": {
				"top": "var(--wp--preset--spacing--40)",
				"bottom": "var(--wp--preset--spacing--40)",
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--navy)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--rink)"
				}
			}
		}
	}
}
