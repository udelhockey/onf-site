{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "navy", "color": "#0C2A3B", "name": "Deep Net Navy" },
				{ "slug": "ice", "color": "#6EC1E4", "name": "Ice Blue" },
				{ "slug": "rink", "color": "#0170B9", "name": "Rink Blue" },
				{ "slug": "rink-dark", "color": "#025A91", "name": "Rink Blue (hover)" },
				{ "slug": "ice-tint", "color": "#E1F1F8", "name": "Ice tint" },
				{ "slug": "ink", "color": "#111418", "name": "Ink" },
				{ "slug": "slate", "color": "#54595F", "name": "Slate" },
				{ "slug": "muted", "color": "#7A7A7A", "name": "Muted gray" },
				{ "slug": "line", "color": "#E5E5E5", "name": "Line" },
				{ "slug": "cloud", "color": "#F2F2F2", "name": "Cloud" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" },
				{ "slug": "on-navy", "color": "#B9CCD6", "name": "Soft text on navy" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Roboto",
					"fontFamily": "Roboto, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Roboto", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/roboto-latin-var.woff2" ] },
						{ "fontFamily": "Roboto", "fontStyle": "italic", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/roboto-latin-italic.woff2" ] }
					]
				},
				{
					"slug": "heading",
					"name": "Exo",
					"fontFamily": "Exo, Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Exo", "fontStyle": "normal", "fontWeight": "500 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/exo-latin-var.woff2" ] },
						{ "fontFamily": "Exo", "fontStyle": "italic", "fontWeight": "800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/exo-latin-800-italic.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Extra small", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2.125rem", "fluid": { "min": "1.625rem", "max": "2.125rem" } },
				{ "slug": "xx-large", "name": "Hero", "size": "3.5rem", "fluid": { "min": "2.375rem", "max": "3.5rem" } },
				{ "slug": "stat", "name": "Stat", "size": "3rem", "fluid": { "min": "2rem", "max": "3rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "0.75rem" },
				{ "slug": "30", "name": "M", "size": "1rem" },
				{ "slug": "40", "name": "L", "size": "1.5rem" },
				{ "slug": "50", "name": "XL", "size": "clamp(1.5rem, 4vw, 2.5rem)" },
				{ "slug": "60", "name": "2XL", "size": "clamp(2rem, 6vw, 3.5rem)" },
				{ "slug": "70", "name": "3XL", "size": "clamp(2.5rem, 8vw, 5rem)" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "card", "name": "Card", "shadow": "0 1px 2px rgba(12, 42, 59, 0.06), 0 4px 16px rgba(12, 42, 59, 0.06)" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"custom": {
			"radius": { "button": "4px", "card": "10px" },
			"button-text-on-ice": "#06222E"
		},
		"blocks": {
			"core/button": {
				"border": { "radius": false }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2rem)",
				"right": "clamp(1rem, 4vw, 2rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--rink)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--rink-dark)" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--rink)", "offset": "2px", "style": "solid", "width": "2px" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--navy)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "700", "lineHeight": "1.15" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "800", "lineHeight": "1.05" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "fontWeight": "700", "lineHeight": "1.1" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "600" } },
			"h4": { "typography": { "fontSize": "1.1875rem", "fontWeight": "600" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "600" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "700", "textTransform": "uppercase", "letterSpacing": "1.5px" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ice)",
					"text": "var(--wp--custom--button-text-on-ice)"
				},
				"border": { "radius": "var(--wp--custom--radius--button)", "width": "2px", "style": "solid", "color": "var(--wp--preset--color--ice)" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.75rem", "right": "1.75rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "0.9375rem", "fontWeight": "700", "lineHeight": "1.3", "textDecoration": "none" },
				":hover": {
					"color": { "background": "var(--wp--preset--color--rink)", "text": "var(--wp--preset--color--white)" },
					"border": { "color": "var(--wp--preset--color--rink)" }
				},
				":focus": { "outline": { "color": "var(--wp--preset--color--rink)", "offset": "2px", "style": "solid", "width": "2px" } }
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--slate)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" },
				"elements": {
					"link": { "typography": { "textDecoration": "none" }, ":hover": { "typography": { "textDecoration": "underline" } } }
				}
			},
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "800" }
			},
			"core/post-title": {
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--navy)" }, "typography": { "textDecoration": "none" } } }
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--slate)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/post-terms": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" },
				"border": { "width": "1px" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--ice)", "width": "4px", "style": "solid" } },
				"spacing": { "padding": { "left": "var(--wp--preset--spacing--40)" } },
				"typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontStyle": "normal" }
			},
			"core/table": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/image": {
				"border": { "radius": "var(--wp--custom--radius--card)" }
			},
			"core/post-featured-image": {
				"border": { "radius": "var(--wp--custom--radius--card)" }
			},
			"core/query-pagination": {
				"typography": { "fontWeight": "500" }
			},
			"core/search": {
				"elements": {
					"button": { "spacing": { "padding": { "top": "0.5rem", "bottom": "0.5rem", "left": "1rem", "right": "1rem" } } }
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "post-meta", "title": "Post meta", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Page (wide, no title)", "postTypes": [ "page" ] },
		{ "name": "donate-page", "title": "Donate page (events and funds taking gifts)", "postTypes": [ "page" ] }
	]
}
